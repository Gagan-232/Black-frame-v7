# --- Database (Railway: reference the Postgres plugin's DATABASE_URL) ---
DATABASE_URL=postgres://user:password@localhost:5432/blackframe
DATABASE_SSL=false

# --- First SUPER_ADMIN, created once by `npm run bootstrap`. Use your OWN strong values. ---
ADMIN_USERNAME=change-me
ADMIN_INITIAL_PASSWORD=change-me-to-a-long-random-password

# --- Object storage (S3-compatible: Cloudflare R2 / Railway bucket) ---
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=blackframe
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Smoke test only (never set in production) ---
# TEST_BASE_URL=http://localhost:3000
